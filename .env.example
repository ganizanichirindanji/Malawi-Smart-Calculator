# Vercel Deployment & Environment Configuration

# GEMINI_API_KEY: Optional API key for server-side Gemini AI features.
# Set this in your Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=""

# APP_URL: Optional custom domain or Vercel URL (e.g. https://your-project.vercel.app)
APP_URL=""

# VITE_APP_TITLE: Optional client-side application branding title
VITE_APP_TITLE="Malawi Scientific Calculator"

# VITE_APP_VERSION: Optional semantic release version display
VITE_APP_VERSION="1.0.0"
